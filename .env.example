# PsyMatch demo environment. Copy to .env for local use; set the same
# variables in Vercel (Project → Settings → Environment Variables).

# Required: an empty MongoDB database. The app seeds it with synthetic demo
# data on first request.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/psymatch_demo?retryWrites=true&w=majority

# Optional. Demo mode is on unless this is 'false'.
# PUBLIC_DEMO_MODE=true
